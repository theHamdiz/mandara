pkgbase = mandara-shell-bin
	pkgdesc = GPU-accelerated, design-first Wayland desktop shell for MangoWM, Niri and Hyprland, written in Rust
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/theHamdiz/mandara
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	depends = fontconfig
	depends = freetype2
	depends = gcc-libs
	depends = glibc
	depends = libxkbcommon
	depends = pam
	depends = vulkan-icd-loader
	depends = wayland
	optdepends = xdg-desktop-portal: open links and follow the system appearance
	optdepends = pipewire-pulse: sound controls, per-app volume and the visualizer
	optdepends = noto-fonts: Arabic and fallback glyphs
	optdepends = inter-font: the default interface font
	optdepends = greetd: Mandara Login as your login manager
	optdepends = accountsservice: Studio user management
	optdepends = udisks2: the Drives panel
	optdepends = upower: battery details
	optdepends = power-profiles-daemon: power profiles
	optdepends = geoclue: location for weather and prayer times
	optdepends = networkmanager: the Network panel
	optdepends = sound-theme-freedesktop: shell sounds
	provides = mandara-shell
	provides = mandara
	conflicts = mandara
	conflicts = mandara-shell
	conflicts = mandara-shell-git
	options = !strip
	options = !debug
	backup = etc/pam.d/mandara-lock
	source_x86_64 = https://github.com/theHamdiz/mandara/releases/download/v0.1.0/mandara-0.1.0-x86_64-linux-gnu.tar.gz
	sha256sums_x86_64 = @SHA256_X86_64@
	source_aarch64 = https://github.com/theHamdiz/mandara/releases/download/v0.1.0/mandara-0.1.0-aarch64-linux-gnu.tar.gz
	sha256sums_aarch64 = @SHA256_AARCH64@

pkgname = mandara-shell-bin
