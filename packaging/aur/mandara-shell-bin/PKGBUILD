# Maintainer: Ahmad Hamdi <ahmad dot hamdi dot emara at gmail dot com>

pkgname=mandara-shell-bin
pkgver=0.8.2
pkgrel=1
pkgdesc="GPU-accelerated, design-first Wayland desktop shell for MangoWM, Niri and Hyprland, written in Rust"
arch=('x86_64' 'aarch64')
url="https://github.com/theHamdiz/mandara"
license=('GPL-3.0-or-later')
depends=('fontconfig' 'freetype2' 'gcc-libs' 'glibc' 'libxkbcommon' 'pam' 'vulkan-icd-loader' 'wayland')
optdepends=('xdg-desktop-portal: open links and follow the system appearance'
            'pipewire-pulse: sound controls, per-app volume and the visualizer'
            'noto-fonts: Arabic and fallback glyphs'
            'inter-font: the default interface font'
            'greetd: Mandara Login as your login manager'
            'accountsservice: Studio user management'
            'udisks2: the Drives panel'
            'upower: battery details'
            'power-profiles-daemon: power profiles'
            'geoclue: location for weather and prayer times'
            'networkmanager: the Network panel'
            'sound-theme-freedesktop: shell sounds')
provides=('mandara-shell' 'mandara')
conflicts=('mandara' 'mandara-shell' 'mandara-shell-git')
backup=('etc/pam.d/mandara-lock')
options=('!strip' '!debug')
source_x86_64=("$url/releases/download/v$pkgver/mandara-$pkgver-x86_64-linux-gnu.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/mandara-$pkgver-aarch64-linux-gnu.tar.gz")
sha256sums_x86_64=('8dd2d45b8f4e233c4f323aff4d93f5ad33826a40d504922c9494546a4d235a78')
sha256sums_aarch64=('4b8a78c0d78584252934e167e717e71c11f00468f3edc9a4a7a426f47b445f20')

package() {
  cd "mandara-$pkgver-$CARCH-linux-gnu"
  install -Dm755 bin/mandara "$pkgdir/usr/bin/mandara"
  install -Dm644 share/applications/org.mandara.studio.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 share/icons/hicolor/scalable/apps/org.mandara.studio.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 share/pam.d/mandara-lock "$pkgdir/etc/pam.d/mandara-lock"
  install -Dm644 README.md PLUGINS.md -t "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 LICENSE.md COPYRIGHT.md -t "$pkgdir/usr/share/licenses/$pkgname/"
}
