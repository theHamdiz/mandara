// Mandara extension platform (API level 1). Additive: the `plugin` and
// `desktop-plugin` worlds in plugin.wit are frozen, so every plugin built
// for them keeps loading unchanged. A plugin built for `extension-plugin`
// has everything a desktop plugin has, plus rich native views, outlets
// (Studio tabs, launcher providers, panels), events and a broker for
// capabilities the person grants and can revoke.
//
// The host enforces every rule here: capabilities are checked when a
// request arrives (not when the plugin loads), and views, payloads,
// queues and call times are bounded. WIT alone grants nothing.
// (Same package as plugin.wit: mandara:plugin@0.1.0.)

interface platform {
    /// What the host offers, given to `negotiate` before `init`.
    record host-info {
        /// The extension API level (1 for this file).
        api: u32,
        /// Every feature this host supports (see PLUGINS.md), such as
        /// "ui.input", "ui.list", "launcher" or "studio-tabs".
        features: list<string>,
        /// The Mandara version, e.g. "0.31.0".
        version: string,
    }
}

interface ui {
    use types.{tone};

    enum kind {
        /// Children side by side / stacked.
        row,
        column,
        /// A rounded surface card around its children.
        card,
        /// Children in `index` equal columns (1–12), wrapping into rows.
        grid,
        /// Children in a vertical scroll area (`style.height` caps it).
        scroll,
        /// A virtual list of `index` rows, each `style.min-height` tall
        /// (default 36), in a `style.height` viewport: the children are
        /// rows `value` .. `value + children`, and scrolling past them
        /// sends a `range` event asking for the rows on screen.
        %list,
        /// `text` as a label.
        text,
        /// `text` names a bundled Mandara icon.
        icon,
        /// A button; `text` is its label (after any children, such as an
        /// icon), `action` its event. `style.tone`: `accent` is the one
        /// filled primary action, `muted` a plain text button, anything
        /// else a quiet tinted button.
        button,
        /// A progress bar, `value` in 0..=1.
        meter,
        /// Flexible empty space.
        spacer,
        /// A thin rule between groups.
        divider,
        /// A one-line text field: `text` is its value, `hint` its
        /// placeholder; sends `text` while typing and `submit` on Enter.
        input,
        /// A switch: on when `value` >= 0.5; sends `checked`.
        toggle,
        /// A slider over `min`..`max` (step `step`, 0 = continuous);
        /// sends `number`.
        slider,
        /// A segmented control: `options`, the chosen one at `index`
        /// (raised); sends `choice` with the option's value. It spans its
        /// parent unless `style.width` is set.
        choice,
        /// An image from a host-issued handle (`image`), drawn at
        /// `style.width` x `style.height`; `hint` is its description.
        image,
        /// Simple vector marks (`marks`) in a `style.width` x
        /// `style.height` box: shapes, bars and lines for charts.
        canvas,
        /// An inset grouped section: one quiet rounded surface whose
        /// children are rows, separated by hairlines (the settings-list
        /// look). Put rows, fields and sliders in groups rather than cards
        /// in cards.
        group,
    }

    /// How children line up across the layout's direction. `auto`: rows
    /// centre their children, columns stretch them.
    enum align { auto, start, center, end, stretch }

    /// Where a view is drawn.
    enum surface { bar, panel, sidebar, desktop, studio, launcher }

    record context {
        surface: surface,
        /// Which outlet: "" for the plugin's own bar item, panel or
        /// sidebar card; a `[[widgets]]` id on the desktop; a
        /// `[[studio-tabs]]` id in Studio.
        outlet: string,
        /// This placed instance (desktop widgets can be placed twice).
        instance: string,
        /// The space it has now, logical px (0 = sized by content).
        width: f32,
        height: f32,
    }

    record option-item { value: string, label: string }

    enum shape {
        rect,
        ellipse,
        /// From (x, y) to (x + width, y + height); `height` may be negative.
        line,
    }

    /// One mark. Coordinates and sizes are fractions (0..=1) of the
    /// canvas, so marks scale with it. No scripts, paths or URLs.
    record mark {
        shape: shape,
        x: f32,
        y: f32,
        width: f32,
        height: f32,
        tone: tone,
        /// 0..=1 (0 is treated as 1, fully opaque).
        opacity: f32,
        /// Corner radius in logical px (rect only).
        radius: f32,
    }

    /// Layout and look. Zero means "the default" for every number.
    record style {
        width: f32,
        height: f32,
        min-width: f32,
        min-height: f32,
        padding: f32,
        gap: f32,
        /// Corner radius in logical px.
        radius: f32,
        /// Font or icon size in logical px.
        size: f32,
        grow: bool,
        bold: bool,
        align: align,
        tone: tone,
    }

    record node {
        /// Unique within the view and stable across renders: it keeps a
        /// field's caret, a list's scroll and keyboard focus. "" for nodes
        /// that keep no state.
        id: string,
        kind: kind,
        text: string,
        /// Placeholder, tooltip or image description.
        hint: string,
        /// Sent back in events ("" = not interactive).
        action: string,
        value: f32,
        min: f32,
        max: f32,
        step: f32,
        /// Grid columns, the chosen option, or a list's row count.
        index: u32,
        /// Indices into the view's node list.
        children: list<u32>,
        style: style,
        options: list<option-item>,
        /// An image handle from the broker (0 = none).
        image: u64,
        marks: list<mark>,
        disabled: bool,
    }

    /// A tree as an arena: `nodes[root]` is the top node. `focus` names a
    /// node id to give keyboard focus to ("" = leave focus alone).
    record view { nodes: list<node>, root: u32, focus: string }

    record key-press {
        /// GPUI key name: "a", "enter", "escape", "up", "pageup", "f5", …
        key: string,
        ctrl: bool,
        alt: bool,
        shift: bool,
        super-key: bool,
    }

    /// A broker reply (or one update of a subscription).
    record reply {
        /// The id `broker.submit` returned.
        id: u64,
        /// Success: a JSON payload. Failure: why, in English.
        outcome: result<string, string>,
    }

    variant value {
        /// A click (or Enter / Space on a focused node).
        activate,
        text(string),
        submit(string),
        number(f32),
        checked(bool),
        choice(string),
        /// The rows a list shows now: first row and count.
        range(tuple<u32, u32>),
        /// A key the focused node didn't use itself.
        key(key-press),
        /// A launcher result was chosen: the hit's id.
        launch(string),
        /// One of the plugin's `[[commands]]` was run (from the CLI, a
        /// shortcut, a hook, a skill or an agent): its name, then the
        /// words after it.
        command(list<string>),
        /// Broker replies, oldest first.
        replies(list<reply>),
    }

    record event {
        context: context,
        /// The node's id ("" for launcher and broker events).
        node: string,
        action: string,
        value: value,
    }

    /// A launcher result.
    record hit {
        /// Sent back in a `launch` event when chosen.
        id: string,
        title: string,
        detail: string,
        /// A bundled Mandara icon, or "" for the plugin's own.
        icon: string,
        /// An image handle (0 = none), drawn instead of the icon.
        image: u64,
        /// Extra words that find it.
        keywords: string,
    }
}

interface broker {
    /// A request to a host service. `capability` names it ("media.read",
    /// "wallpaper.set", "net:api.example.com", …): the plugin must
    /// declare it in plugin.toml and the person must have granted it.
    /// `payload` is a JSON object of at most 16 KiB.
    record request { capability: string, operation: string, payload: string }

    /// Queues a request and returns its id at once; never waits. The
    /// result arrives later as a `replies` event. Fails at once when the
    /// capability isn't declared, granted or known, the payload is too
    /// large, too many requests are already waiting, or the operation needs
    /// a user gesture (reading the clipboard, opening a page, setting a
    /// wallpaper, closing a window) and the plugin isn't handling a click,
    /// key press, typed text, launcher choice or command right now.
    submit: func(request: request) -> result<u64, string>;
    /// Ends a subscription or drops a waiting request.
    cancel: func(id: u64);
    /// The capabilities granted right now (they can change at any time).
    granted: func() -> list<string>;
    /// A handle for an image the plugin ships in its folder (`assets/`,
    /// PNG, JPEG or WebP): a name like "moon.png", no folders.
    asset-image: func(name: string) -> result<u64, string>;
}

/// The plugin's own private key-value storage: kept across restarts,
/// bounded (1024 keys, 128-byte keys, 64 KiB values, 1 MiB in all) and
/// out of every other plugin's reach. Values are yours to encode (JSON is
/// a good choice).
interface storage {
    get: func(key: string) -> option<string>;
    set: func(key: string, value: string) -> result<_, string>;
    remove: func(key: string);
    keys: func() -> list<string>;
}

/// Rich native UI, outlets and the broker, on top of `desktop-plugin`.
/// Its older exports stay as fallbacks: when `extension-view` returns
/// none for a surface, Mandara asks `bar`, `panel`, `sidebar` or
/// `desktop-widget` as before, so a plugin can move one surface at a time.
world extension-plugin {
    include desktop-plugin;
    // Renamed: `include` brings in desktop-plugin's own `palette` and `view`.
    use types.{palette as theme};
    use platform.{host-info};
    use ui.{context, view as rich-view, event, hit};
    import broker;
    import storage;

    /// Called first, before `init`: return the features you use. Loading
    /// stops with a clear message when the host lacks one, so a plugin
    /// never half-works on an older Mandara.
    export negotiate: func(host: host-info) -> list<string>;
    /// The view for a surface and outlet (none = use the older export).
    export extension-view: func(palette: theme, context: context) -> option<rich-view>;
    /// Input, launcher choices and broker replies.
    export extension-event: func(event: event);
    /// Results for a declared `[[launcher]]` provider (at most `limit`).
    export launcher-query: func(provider: string, query: string, limit: u32) -> list<hit>;
    /// Another plugin calls one of the operations this one `serves`.
    /// `payload` and the answer are JSON.
    export extension-call: func(caller: string, operation: string, payload: string) -> result<string, string>;
}
